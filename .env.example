# XR environment template. Copy to .env and fill in. NEVER commit a real .env.
# Every value below is optional unless marked REQUIRED for production.

NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# SQLite database file (put it on a persistent volume!). REQUIRED for production.
XR_DB_FILE=/data/xr.db

# Where `npm run backup` writes consistent snapshots, and how many to keep.
XR_BACKUP_DIR=/data/backups
XR_BACKUP_RETAIN=14

# Behind a TLS-terminating proxy (Caddy/nginx/platform router): trust X-Forwarded-For
# so rate limits and session records see the real client IP. Only enable behind a proxy you control.
TRUST_PROXY=true
# Send Strict-Transport-Security. Enable once the site is HTTPS-only.
HSTS=true

# Only needed if the web app is served from a DIFFERENT origin than the API (comma-separated).
# Default (empty) = same-origin only, no CORS headers.
CORS_ORIGINS=

# Request body limit in bytes (default 1048576) and session policy.
MAX_BODY_BYTES=1048576
SESSION_TTL_HOURS=24
SESSION_IDLE_MINUTES=60

# Simulated payment / WhatsApp providers. Leave UNSET in production: they are then refused.
# (Set to true only for a demo/staging environment that never handles real customers.)
# ALLOW_MOCK_PROVIDERS=false

# Payment provider webhook secret (>= 32 random chars). Required before ANY payment webhook is accepted.
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
PAYMENT_WEBHOOK_SECRET=

# One-time, used only by `npm run bootstrap` (first business + Owner). Remove after use.
# XR_BOOTSTRAP_PASSWORD=
