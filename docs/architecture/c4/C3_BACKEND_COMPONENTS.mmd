C4Component
  title C3 — XR API Application: Backend Components (implemented vs target)

  Container_Boundary(api, "XR API Application") {
    Component(auth, "AuthComponent", "Service", "Login, sessions, scrypt hashing. IMPLEMENTED")
    Component(rbac, "RBACComponent", "Service", "Role/permission checks. IMPLEMENTED")
    Component(tenant, "BusinessTenantComponent", "Service", "Business-scoped isolation. IMPLEMENTED")
    Component(audit, "AuditComponent", "Service", "Actor/action/resource log. IMPLEMENTED")
    Component(product, "ProductCatalogComponent", "Service", "Product CRUD, flat category. IMPLEMENTED")
    Component(pricing, "PricingComponent", "Service", "Min/Rec/Max price + history. IMPLEMENTED")
    Component(supplier, "SupplierComponent", "Service", "Supplier CRUD. IMPLEMENTED")
    Component(procurement, "ProcurementComponent", "Service", "Draft to Receive purchase. IMPLEMENTED")
    Component(ledger, "InventoryLedgerComponent", "Service", "Batch movement ledger. IMPLEMENTED")
    Component(fifo, "FIFOCostingComponent", "Service", "FIFO allocation + COGS. IMPLEMENTED")
    Component(aging, "StockAgingComponent", "Service", "Age from receipt date. IMPLEMENTED")

    Component(gpc, "GPCClassificationComponent", "Service", "TARGET - GS1 GPC import/search")
    Component(pos, "POSComponent", "Service", "TARGET - cart, checkout")
    Component(sales, "SalesComponent", "Service", "TARGET - sale + idempotency")
    Component(payment, "PaymentComponent", "Service", "TARGET - provider abstraction")
    Component(customer, "CustomerComponent", "Service", "TARGET")
    Component(returns, "ReturnsComponent", "Service", "TARGET")
    Component(refunds, "RefundsComponent", "Service", "TARGET")
    Component(expense, "ExpenseComponent", "Service", "TARGET")
    Component(finance, "FinanceComponent", "Service", "TARGET - Revenue/COGS/Profit")
    Component(analytics, "AnalyticsComponent", "Service", "TARGET - velocity/demand trend")
    Component(document, "DocumentComponent", "Service", "TARGET - receipts/invoices")
    Component(notify, "NotificationComponent", "Service", "TARGET - WhatsApp/queue")
  }

  Rel(procurement, ledger, "Creates batch + movements on receive")
  Rel(ledger, fifo, "Allocates cost on consumption")
  Rel(ledger, aging, "Computes age from batch receipt")
  Rel(product, pricing, "Validates price on save")
  Rel(auth, rbac, "Resolves user permissions")
  Rel(rbac, tenant, "Scopes checks to business")
  Rel(procurement, audit, "Writes audit entries")
  Rel(product, audit, "Writes audit entries")

