  Rel(sales, fifo, "Allocates batches for sale", "TARGET")
  Rel(sales, pricing, "Revalidates price server-side", "TARGET")
  Rel(sales, ledger, "Deducts stock", "TARGET")
  Rel(sales, payment, "Records payment state", "TARGET")
  Rel(sales, finance, "Feeds revenue + COGS", "TARGET")
  Rel(sales, document, "Triggers receipt generation", "TARGET")
  Rel(sales, audit, "Writes audit entries", "TARGET")
  Rel(returns, ledger, "Reverses stock", "TARGET")
  Rel(returns, refunds, "Triggers refund", "TARGET")
  Rel(expense, finance, "Feeds net profit", "TARGET")
  Rel(finance, analytics, "Authoritative source for metrics", "TARGET")
  Rel(product, gpc, "Classifies against taxonomy", "TARGET")
  Rel(document, notify, "Queues delivery", "TARGET")
